# =============================================================================
# Normelya — variables d'environnement
#
# Aucune valeur secrète ne doit porter le préfixe NEXT_PUBLIC_ : tout ce qui est
# préfixé ainsi est envoyé au navigateur.
# =============================================================================

NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de données ---------------------------------------------------------
# Rôle applicatif : soumis aux politiques RLS, sans BYPASSRLS.
DATABASE_URL=postgres://normelya_app:motdepasse@localhost:5432/normelya
# Rôle de service : écritures de confiance uniquement (création de compte,
# journal d'audit, webhooks de paiement).
SERVICE_DATABASE_URL=postgres://normelya_service:motdepasse@localhost:5432/normelya

# --- Authentification et stockage --------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=normelya-documents

# --- Courrier transactionnel -------------------------------------------------
# console : rien n'est envoyé, tout s'affiche dans le terminal (développement).
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Normelya <bonjour@normelya.com>

# --- Sécurité ----------------------------------------------------------------
# Sel utilisé pour les empreintes d'adresses IP et d'agents utilisateur.
HASH_SALT=changez-cette-valeur-par-environnement

# --- Assistance par IA -------------------------------------------------------
# Désactivée par défaut. Aucune donnée ne sort de l'infrastructure tant que
# cette valeur reste à false.
AI_ENABLED=false

# --- Tests -------------------------------------------------------------------
# PostgreSQL utilisé par les tests d'intégration et de RLS.
# Sans cette variable, ces tests sont ignorés.
TEST_DATABASE_URL=
